# FullScopeTest 环境变量配置示例
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# 注意: .env 文件不应提交到版本控制

# ===== 数据库配置 =====
POSTGRES_USER=fullscopetest
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=fullscopetest_dev

# 完整数据库连接 URL (生产环境使用)
DATABASE_URL=postgresql://fullscopetest:<your-postgres-password>@host.docker.internal:5432/fullscopetest_prod

# 测试数据库连接 URL (CI/CD 使用)
TEST_DATABASE_URL=postgresql://fullscopetest:<your-postgres-password>@127.0.0.1:5432/fullscopetest_test

# ===== Redis 配置 =====
REDIS_PASSWORD=<your-redis-password>
REDIS_URL=redis://redis:6379/0

# ===== 安全密钥 (必须修改!) =====
SECRET_KEY=<generate-a-random-secret-key>
JWT_SECRET_KEY=<generate-a-random-jwt-secret-key>
VNC_PASSWORD=<your-vnc-password>
METRICS_TOKEN=<your-metrics-access-token>

# ===== 应用运行配置 =====
APP_ENV=development

# ===== SSRF 防护白名单（可选）=====
# 逗号分隔的主机名，这些主机将被允许作为请求目标（绕过内网地址检查）
# 开发环境示例：SSRF_ALLOWLIST_HOSTS=localhost,127.0.0.1
# SSRF_ALLOWLIST_HOSTS=

# ===== Cookie 安全配置（可选）=====
# JWT Token 通过 httpOnly Cookie 传递，XSS 无法窃取
# COOKIE_SECURE=true   # 生产环境默认 true，开发环境设为 false
# COOKIE_SAMESITE=Lax  # Lax / Strict / None
# COOKIE_DOMAIN=       # 留空则不设置 domain

# 后端监听端口 (开发环境: 5000, 生产环境: 8000)

# ===== AI 助手配置 (可选) =====
# AI_ASSISTANT_BASE_URL=https://api.openai.com/v1
# AI_ASSISTANT_API_KEY=<your-openai-api-key>
# AI_ASSISTANT_MODEL=gpt-4o-mini

# ===== Aliyun OSS 配置 (可选) =====
# OSS_ENDPOINT=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET_NAME=
# OSS_DOMAIN=

# ===== 安全 / 代理（2026-09 新增）=====
# 仅当部署在已知反向代理之后（nginx/网关已覆写 X-Forwarded-For）时设为 true；
# 默认不信任 XFF 头，客户端 IP 取直连地址
TRUST_PROXY_HEADERS=false
# Redis 故障时限流策略：true=放行(fail-open)，false=拒绝(fail-closed，生产推荐)
# 未设置时：开发环境 fail-open，APP_ENV=production 默认 fail-closed
# RATE_LIMIT_FAIL_OPEN=false
# Prometheus /metrics 保护（为空则指标端点无需认证）
METRICS_TOKEN=
# 首次启动自动创建管理员（无默认口令，必须显式提供）
# INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_EMAIL=admin@example.com
# INIT_ADMIN_PASSWORD=<强口令>
# 演示种子数据口令（scripts/seed_gen.py，禁止用于生产）
# SEED_PASSWORD=<强口令>
